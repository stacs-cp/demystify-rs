language ESSENCE' 1.0

given grid_size : int
given top_labels : matrix indexed by [int(1..grid_size)] of int(1..sum( [i | i : int(1..grid_size)] ))
given right_labels : matrix indexed by [int(1..grid_size)] of int(1..sum( [i | i : int(1..grid_size)] ))


$#VAR res
find res : matrix indexed by [int(1..grid_size), int(1..grid_size)] of int(0,1)

$#CON rowcon "The sum of row {{index[0]}} is {{params['right_labels'][index[0]]}}"
find rowcon : matrix indexed by [int(1..grid_size)] of bool

$#CON colcon "The sum of column {{index[0]}} is {{params['top_labels'][index[0]]}}"
find colcon : matrix indexed by [int(1..grid_size)] of bool


such that
    forAll r : int(1..grid_size) .
        rowcon[r] -> (sum( [ res[r,i]*i | i : int(1..grid_size)] ) = right_labels[r]),

    forAll c : int(1..grid_size) .
        colcon[c] -> (sum( [ res[i,c]*i | i : int(1..grid_size)] ) = top_labels[c]),

true

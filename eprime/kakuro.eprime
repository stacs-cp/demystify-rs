language ESSENCE' 1.0

given width,height : int
letting X be int(1..width)
letting Y be int(1..height)

given blanks : matrix indexed by [X,Y] of int(0..1)
given vertsums: matrix indexed by [X,Y] of int
given horzsums: matrix indexed by [X,Y] of int

where forAll x: X. forAll y : Y. vertsums[x,y] != 0 -> blanks[x+1,y] = 1
where forAll x: X. forAll y : Y. horzsums[x,y] != 0 -> blanks[x,y+1] = 1

$#VAR grid
$#SHOW grid main
find grid : matrix indexed by [X,Y] of int(0..9)

$ Per maximal block: a single bool whose index identifies the block by
$ its (start, end, column) endpoints.  The block runs (x1, y) .. (x2, y)
$ inclusive, all cells playable, with non-playable boundaries on both
$ sides.  The constraint below fires allDiff over the entire block.
$#CON vertalldiff "The vertical block in column {{index[2]}} from row {{index[0]}} to row {{index[1]}} is all-different"
find vertalldiff: matrix indexed by [X,X,Y] of bool

$#CON vertsum "The vertical block starting at {{[index[0], index[1]]}} sums to {{params['vertsums'][index[0]][index[1]]}}"
find vertsum: matrix indexed by [X,Y] of bool

$#CON horzalldiff "The horizontal block in row {{index[0]}} from column {{index[1]}} to column {{index[2]}} is all-different"
find horzalldiff: matrix indexed by [X,Y,Y] of bool

$#CON horzsum "The horizontal block starting at {{[index[0], index[1]]}} sums to {{params['horzsums'][index[0]][index[1]]}}"
find horzsum: matrix indexed by [X,Y] of bool


such that
forAll x : X. forAll y : Y. blanks[x,y] = 0 <-> grid[x,y] = 0,


$ vertalldiff[x1, x2, y] is the alldiff for the vertical block in column y
$ running from cell (x1, y) to cell (x2, y) inclusive.  The constraint
$ only fires when (x1, x2, y) actually identifies a maximal block:
$ - x1 < x2,
$ - every cell in [x1..x2] is playable (blanks = 1),
$ - the cell just above x1 is either off-grid or non-playable (header),
$ - the cell just below x2 is either off-grid or non-playable (header).
$ All other (x1, x2, y) triples have their bool as a no-op so the MUS
$ search never picks them up.
forAll x1 : X. forAll x2 : int(x1+1..width). forAll y : Y.
vertalldiff[x1, x2, y] ->
    ( ( and([ blanks[i, y] = 1 | i : int(x1..x2) ])
        /\ (x1 = 1 \/ blanks[x1-1, y] = 0)
        /\ (x2 = width \/ blanks[x2+1, y] = 0) )
      -> allDiff([ grid[i, y] | i : int(x1..x2) ]) ),


forAll x: X. forAll y : Y.
vertsum[x,y] -> (
vertsums[x,y] != 0 ->
( vertsums[x,y] = sum([ grid[i,y] | i : int(x+1..width), forAll q:int(x+1..i). blanks[q,y]=1]) )),


$ horzalldiff[x, y1, y2] — same shape, this time horizontally in row x.
forAll x : X. forAll y1 : Y. forAll y2 : int(y1+1..height).
horzalldiff[x, y1, y2] ->
    ( ( and([ blanks[x, j] = 1 | j : int(y1..y2) ])
        /\ (y1 = 1 \/ blanks[x, y1-1] = 0)
        /\ (y2 = height \/ blanks[x, y2+1] = 0) )
      -> allDiff([ grid[x, j] | j : int(y1..y2) ]) ),


forAll x: X. forAll y : Y.
horzsum[x,y] -> (
horzsums[x,y] != 0 ->
( horzsums[x,y] = sum([ grid[x,j] | j : int(y+1..height), forAll q:int(y+1..j). blanks[x,q]=1]) )),

true
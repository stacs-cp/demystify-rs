  [7, 4, 8, 6, 6, 6, 3, 8;int(1..8)],
  [8, 8, 8, 6, 6, 3, 3, 8;int(1..8)],
  [8, 8, 8, 8, 8, 8, 8, 8;int(1..8)]
;int(1..8)]

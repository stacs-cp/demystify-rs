language ESSENCE' 1.0
letting grid_size be 8
letting starcount be 1
letting cages be [
  [1, 1, 1, 1, 1, 1, 1, 2;int(1..8)],
  [3, 3, 1, 3, 1, 2, 2, 2;int(1..8)],
  [4, 3, 3, 3, 1, 1, 1, 2;int(1..8)],
  [4, 3, 3, 1, 1, 5, 1, 2;int(1..8)],
  [4, 3, 6, 7, 1, 5, 1, 1;int(1..8)],
  [4, 6, 6, 7, 8, 5, 1, 5;int(1..8)],
  [4, 6, 5, 8, 8, 5, 1, 5;int(1..8)],
  [6, 6, 5, 5, 5, 5, 5, 5;int(1..8)]
;int(1..8)]

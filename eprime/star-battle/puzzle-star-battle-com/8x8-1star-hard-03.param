letting cages be [
  [1, 2, 2, 3, 3, 3, 4, 5;int(1..8)],
  [1, 1, 4, 3, 4, 4, 4, 5;int(1..8)],
  [1, 6, 4, 4, 4, 4, 5, 5;int(1..8)],
  [1, 6, 6, 4, 4, 4, 5, 5;int(1..8)],
  [1, 6, 4, 4, 4, 7, 5, 5;int(1..8)],
  [6, 6, 4, 4, 7, 7, 5, 5;int(1..8)],
  [6, 6, 7, 7, 7, 7, 5, 5;int(1..8)],
  [8, 8, 8, 8, 8, 8, 8, 5;int(1..8)]
;int(1..8)]

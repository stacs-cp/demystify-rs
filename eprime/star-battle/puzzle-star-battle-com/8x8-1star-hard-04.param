language ESSENCE' 1.0
letting grid_size be 8
letting starcount be 1
letting cages be [
  [1, 1, 1, 1, 1, 1, 1, 1;int(1..8)],
  [1, 1, 2, 2, 2, 2, 1, 3;int(1..8)],
  [4, 4, 2, 4, 1, 1, 1, 3;int(1..8)],
  [5, 4, 2, 4, 4, 1, 1, 6;int(1..8)],
  [5, 4, 4, 4, 1, 1, 1, 6;int(1..8)],
  [5, 5, 7, 7, 7, 7, 1, 6;int(1..8)],
  [5, 5, 7, 7, 8, 7, 6, 6;int(1..8)],
  [5, 5, 5, 5, 8, 8, 8, 8;int(1..8)]
;int(1..8)]

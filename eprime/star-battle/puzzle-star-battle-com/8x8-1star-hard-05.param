language ESSENCE' 1.0
letting grid_size be 8
letting starcount be 1
letting cages be [
  [1, 1, 2, 2, 2, 2, 2, 2;int(1..8)],
  [3, 1, 2, 2, 4, 4, 5, 2;int(1..8)],
  [3, 3, 2, 2, 4, 4, 5, 5;int(1..8)],
  [3, 4, 4, 4, 4, 4, 4, 5;int(1..8)],
  [6, 4, 6, 6, 6, 6, 6, 7;int(1..8)],
  [6, 4, 4, 6, 6, 6, 8, 7;int(1..8)],
  [6, 6, 6, 6, 6, 6, 8, 8;int(1..8)],
  [6, 6, 8, 8, 8, 8, 8, 8;int(1..8)]
;int(1..8)]

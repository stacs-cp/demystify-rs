language ESSENCE' 1.0

$ Default Sudoku model.
$
$ The all-different relation is expressed as a single "at most one X per
$ row/col/box" atom (`row_atmost[i, d]`) instead of being decomposed into
$ all 36 pairwise atoms (`row_alldiff[i, j1, j2, d]`). Together with
$ `row_contains[i, d]` ("at least one X"), the pair forms an exactly-one
$ constraint per (row, digit).
$
$ This formulation produces sharp single-fingerprint signatures for
$ naked/hidden pairs and triples in the demystify named-strategy view, and
$ runs ~9x faster than the pairwise alldiff version on representative
$ instances. The pairwise version is preserved at `sudoku-pairwise.eprime`
$ for paper comparison.

$#KIND Sudoku

letting D be domain int(1..9)
letting Ds be {1,2,3,4,5,6,7,8,9}

letting C be domain int(0..2)

given fixed : matrix indexed by [D,D] of int(0..9)

$#VAR grid
$#SHOW grid main
find grid : matrix indexed by [D,D] of D

$#CON row_atmost "Row {{index[0]}} contains at most one {{index[1]}}"
find row_atmost: matrix indexed by [D,D] of bool

$#CON con_atmost "Column {{index[0]}} contains at most one {{index[1]}}"
find con_atmost: matrix indexed by [D,D] of bool

$#CON box_atmost "The box starting at ({{1+3*index[0]}},{{1+3*index[1]}}) contains at most one {{index[2]}}"
find box_atmost: matrix indexed by [C,C,D] of bool

$#CON row_contains "Row {{index[0]}} must contain a {{index[1]}}"
find row_contains: matrix indexed by [D,D] of bool

$#CON con_contains "Column {{index[0]}} must contain a {{index[1]}}"
find con_contains: matrix indexed by [D,D] of bool

$#CON box_contains "The box starting at ({{1+3*index[0]}},{{1+3*index[1]}}) must contain a {{index[2]}}"
find box_contains: matrix indexed by [C,C,D] of bool

$#FAMILY unit_atmost "Unit at-most"   row_atmost "Row" con_atmost "Column" box_atmost "Box"
$#FAMILY line_atmost "Line at-most"   row_atmost "Row" con_atmost "Column"
$#FAMILY unit_contains "Unit contains" row_contains "Row" con_contains "Column" box_contains "Box"
$#FAMILY line_contains "Line contains" row_contains "Row" con_contains "Column"

such that
forAll i,j: D.
    fixed[i,j] != 0 -> grid[i,j]=fixed[i,j],

forAll i,d:D.
    row_atmost[i,d] -> (sum([toInt(grid[i,j]=d) | j:D]) <= 1),

forAll i,d:D.
    row_contains[i,d] -> or([grid[i,j]=d | j:D]),


forAll j,d:D.
    con_atmost[j,d] -> (sum([toInt(grid[i,j]=d) | i:D]) <= 1),

forAll j,d:D.
    con_contains[j,d] -> or([grid[i,j]=d | i:D]),


forAll a,b:C. forAll d:D.
    box_atmost[a,b,d] ->
       (sum([toInt(grid[1+3*a+i,1+3*b+j] = d) | i : C, j : C]) <= 1),

forAll a,b:C. forAll d:D.
    box_contains[a,b,d] ->
       or([grid[1+3*a+i,1+3*b+j] = d | i : C, j : C]),

1=1

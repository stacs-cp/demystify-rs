$ http://www.tectonicpuzzel.eu/thermometer-sudoku-puzzle-solving-strategy.html

$ Orientation: therms[X,Y] is indexed [column, row] by the model, so this matrix is
$ written column by column; grid[r,c] is the page's row r, column c.  (Before
$ 2026-10-11 this param was the page puzzle transposed.)

letting width be 10
letting height be 10
letting step be 10
letting thermcount be 25


letting therms be [
    [  1,   2,   3,   4, 111, 215, 214, 213, 212, 211],
    [ 11,  12,  13,  14, 112, 131, 171, 172, 173, 174],
    [ 21,  93,  92,  91, 113, 132, 224, 223, 222, 221],
    [ 22,  43,  61, 107, 114, 133, 186, 196, 206, 236],
    [ 23,  42,  62, 106, 115, 134, 185, 195, 205, 235],
    [ 24,  41,  63, 105, 121, 122, 184, 194, 204, 234],
    [ 25,  72,  71, 104, 142, 141, 183, 193, 203, 233],
    [ 31,  53,  81, 103, 152, 151, 182, 192, 202, 232],
    [ 32,  52,  82, 102, 162, 161, 181, 191, 201, 231],
    [ 33,  51,  83, 101, 246, 245, 244, 243, 242, 241]
]

letting row_sums be [7,8,9,5,8,6,1,4,3,4]
letting col_sums be [8,10,4,5,4,5,1,7,7,4]
